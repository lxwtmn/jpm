<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.alexanderwittmann</groupId>
  <artifactId>jpm</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>jpm</name>
  <description>Manage Maven dependencies the way npm does</description>
  <url>https://github.com/lxwtmn/jpm</url>

  <licenses>
    <license>
      <name>The Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Bytecode target 17 (DESIGN E-1), built on a newer JDK. -->
    <maven.compiler.release>17</maven.compiler.release>

    <!-- Version placement per DESIGN B-2: artifactId.version -->
    <picocli.version>4.7.7</picocli.version>
    <!-- The Maven 3.9 generation: resolver 1.9.x. Mixing in maven-resolver-api 2.x breaks. -->
    <maven.version>3.9.16</maven.version>
    <maven-resolver.version>1.9.27</maven-resolver.version>
    <!-- Matches the slf4j-api the resolver already pulls in; a split would reintroduce the warning. -->
    <slf4j.version>1.7.36</slf4j.version>
    <junit-jupiter.version>6.1.3</junit-jupiter.version>
    <assertj-core.version>3.27.7</assertj-core.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.5.6</maven-failsafe-plugin.version>
    <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
      <version>${picocli.version}</version>
    </dependency>

    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-artifact</artifactId>
      <version>${maven.version}</version>
    </dependency>
    <!--
      ADR-0004: the resolver is embedded so that settings.xml, mirrors, proxies and
      authentication against a private artifact repository are correct rather than
      reimplemented. Its local repository is pointed at jpm's own cache, never ~/.m2 (P5).
    -->
    <dependency>
      <groupId>org.apache.maven.resolver</groupId>
      <artifactId>maven-resolver-supplier</artifactId>
      <version>${maven-resolver.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-resolver-provider</artifactId>
      <version>${maven.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-settings-builder</artifactId>
      <version>${maven.version}</version>
    </dependency>
    <!--
      The resolver logs through SLF4J. Without a binding on the classpath, SLF4J prints a
      three-line warning to stderr on every single invocation — noise the user must never see.
      jpm has no logging story yet, so the honest binding is the one that discards everything.
    -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>${slf4j.version}</version>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit-jupiter.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj-core.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- jpm.properties needs ${project.version}; filter nothing else. -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>jpm.properties</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>jpm.properties</exclude>
        </excludes>
      </resource>
      <!-- Apache-2.0 section 4: licence and notices travel inside the artifact. -->
      <resource>
        <directory>${project.basedir}</directory>
        <targetPath>META-INF</targetPath>
        <filtering>false</filtering>
        <includes>
          <include>LICENSE</include>
          <include>NOTICE</include>
        </includes>
      </resource>
      <!--
        Not every bundled component is Apache-2.0: ASM is BSD-3-Clause and slf4j is MIT, and
        neither ships its licence text inside its own JAR. Both licences require the text to
        travel with a redistribution, so we carry it. Anything added here has to be listed in
        NOTICE as well.
      -->
      <resource>
        <directory>src/main/licenses</directory>
        <targetPath>META-INF/licenses</targetPath>
        <filtering>false</filtering>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
      </plugin>

      <!-- Integration tests exercise the built artifact, so they run after packaging. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${maven-failsafe-plugin.version}</version>
        <configuration>
          <systemPropertyVariables>
            <!-- So the test can prove the reported version is the one that was built. -->
            <jpm.expected.version>${project.version}</jpm.expected.version>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${maven-shade-plugin.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>jpm</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.alexanderwittmann.jpm.cli.Main</mainClass>
                  <manifestEntries>
                    <Implementation-Version>${project.version}</Implementation-Version>
                  </manifestEntries>
                </transformer>
                <!--
                  No ApacheLicenseResourceTransformer: measured, it discards ALL
                  META-INF/LICENSE entries including our own, and the artifact would
                  ship without a licence text. Our LICENSE arrives through the
                  <resources> block instead. Colliding licence files from dependencies
                  only become real with the Maven Resolver in issue #3.
                -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                  <projectName>jpm</projectName>
                  <organizationName>Alexander Wittmann Consulting GmbH</organizationName>
                  <organizationURL>https://github.com/lxwtmn/jpm</organizationURL>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
